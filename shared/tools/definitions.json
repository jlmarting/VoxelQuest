          "voxels": { "type": "array", "description": "Lista de subvoxels explícitos (modo A). Cada uno: {x,y,z,color,size} en coordenadas locales.",
            "items": {
              "type": "object",
              "properties": {
                "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
                "color": { "type": "integer" }, "size": { "type": "number" }
              }
            }
          },
          "generator": { "type": "string", "enum": ["sphere", "cube", "pyramid", "helix", "cross", "humanoid_bust"], "description": "Generador built-in (modo B)" },
          "params": { "type": "object", "description": "Parámetros del generador: radius/height/base/side/arm/turns/color según el caso" },
          "anchored": { "type": "boolean", "description": "Si true, estática (mass=0). Por defecto true." },
          "destructible": { "type": "boolean" },
          "mass": { "type": "number", "description": "Por defecto 0 si anchored, 1 si no" },
