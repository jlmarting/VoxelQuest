          "anchored": { "type": "boolean", "description": "Si true, no responde a física (estatua)" },
          "owner_id": { "type": ["integer", "null"] },
          "motion": { "type": "object", "description": "Movimiento programable (waypoints/dynamic/orbit/parametric/rotate)" },
