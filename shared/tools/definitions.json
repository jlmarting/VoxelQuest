    "create_object": {
      "description": "Crear un objeto móvil (box, sphere, sculpture, projectile, vehicle) con física de colisiones y opcionalmente destruible. position=[x,y,z] en unidades de voxel (centro del objeto). scale admite fracciones (subvoxel).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["box", "sphere", "sculpture", "projectile", "vehicle"] },
          "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "scale": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "color": { "type": "integer", "description": "Color RGB entero (p.ej. 16744448 = 0xff8800)" },
          "mass": { "type": "number", "description": "kg; 0 = estático (no responde a fuerzas)" },
          "restitution": { "type": "number", "description": "Coef. de rebote (0=plástico, 1=elástico)" },
          "friction": { "type": "number" },
          "health": { "type": "number" },
          "destructible": { "type": "boolean" },
          "fragile": { "type": "number", "description": "Umbral de energía cinética para romperse por colisión" },
          "collision_group": { "type": "integer" },
